# Copy to .env and fill in real values. Never commit .env.

# ESPN private league credentials (from browser cookies on fantasy.espn.com)
ESPN_LEAGUE_ID=
ESPN_YEAR=
ESPN_S2=
ESPN_SWID=

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Comma-separated, e.g. localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
